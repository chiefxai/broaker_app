APP_NAME=Broaker API
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:8082,http://127.0.0.1:8082
AUTO_CREATE_TABLES=false
API_BIND_HOST=127.0.0.1

# PostgreSQL. Use a managed secret store for deployed environments.
DATABASE_URL=postgresql+asyncpg://broaker:broaker-dev-password@localhost:5432/broaker
REDIS_URL=redis://localhost:6379/0
# Local Compose starts Redis with this password. Change it for any shared environment.
REDIS_PASSWORD=broaker-dev-redis-password

# Local/testing uses backend-owned email/password accounts. This provider is rejected outside
# local/development/test environments; use Cognito for production.
AUTH_PROVIDER=password
PASSWORD_AUTH_SECRET=
SHARE_LINK_ENCRYPTION_KEY=
PASSWORD_ACCESS_TOKEN_TTL_SECONDS=28800

# Amazon Cognito User Pool. Find the pool ID and app client ID in the Cognito console.
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_REPLACE_ME
COGNITO_APP_CLIENT_ID=REPLACE_ME

# Keycloak local testing. Compose overrides the JWKS URL with its internal service URL.
# For a physical device, set issuer, bind host, and hostname to the Mac LAN address.
KEYCLOAK_BIND_HOST=127.0.0.1
KEYCLOAK_HOSTNAME=http://localhost:8081
KEYCLOAK_ISSUER=http://localhost:8081/realms/broaker-test
KEYCLOAK_JWKS_URL=http://localhost:8081/realms/broaker-test/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=broaker-api
# Create a confidential service client with realm-management/manage-users. Keep the secret backend-only.
KEYCLOAK_REGISTRATION_CLIENT_ID=
KEYCLOAK_REGISTRATION_CLIENT_SECRET=
# Leave blank for Compose (http://keycloak:8080); host-run API derives this from KEYCLOAK_ISSUER.
KEYCLOAK_ADMIN_BASE_URL=

# Local MinIO. Keep S3 credentials aligned with the MinIO root credentials.
MINIO_ROOT_USER=broaker-minio
MINIO_ROOT_PASSWORD=local-minio-password
MINIO_IMAGE=minio/minio:latest
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Leave blank for Compose, which uses the internal http://minio:9000 endpoint.
# Set http://localhost:9000 on desktop; use the host LAN address for Expo Go devices.
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=broaker-documents
S3_ACCESS_KEY_ID=broaker-minio
S3_SECRET_ACCESS_KEY=local-minio-password
S3_ADDRESSING_STYLE=path
S3_PRESIGNED_URL_EXPIRES_SECONDS=600
S3_MAX_UPLOAD_BYTES=26214400

# Public API URL used when returning share-link URLs.
PUBLIC_API_BASE_URL=http://localhost:8000
