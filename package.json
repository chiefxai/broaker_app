{
  "name": "mobile-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.26",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.105.1",
    "axios": "^1.21.0",
    "expo": "~58.0.22",
    "expo-audio": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-local-authentication": "~58.0.2",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "^1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "axios-mock-adapter": "^2.1.0",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:mock": "node ./scripts/start-mock.js",
    "web:mock": "node ./scripts/start-mock.js --web",
    "web:local": "node ./scripts/start-live.js --web --port 5173",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --runInBand --coverage",
    "test:coverage": "jest --coverage --coverageReporters=text --coverageReporters=lcov",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint"
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-reanimated/jest/resolver",
    "setupFilesAfterEnv": [
      "<rootDir>/test/jest-setup.js"
    ],
    "moduleNameMapper": {
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/src/app/"
    ]
  },
  "private": true
}
