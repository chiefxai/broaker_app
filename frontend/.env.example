EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
# For a physical device, replace localhost with the development machine's LAN address.
# Public share links open this app URL; set it to a device-reachable web origin for native builds.
EXPO_PUBLIC_PUBLIC_APP_URL=http://localhost:8082
EXPO_PUBLIC_AUTH_PROVIDER=password
# Restrict browser keys by allowed website referrer and native keys by app identity.
# Enable Maps JavaScript API for web and Maps SDK for iOS/Android for native builds.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_WEB=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=
